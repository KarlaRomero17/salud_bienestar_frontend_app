# Variables de entorno - Archivo de ejemplo
# 🚨 IMPORTANTE: Copia este archivo como .env y configura tu IP local

# ============================================================
# URL del servidor backend
# ============================================================
# Cada desarrollador debe configurar su propia IP según su entorno:
#
# 📱 Para Android Emulator: http://10.0.2.2:5000
# 📱 Para iOS Simulator: http://localhost:5000
# 📱 Para dispositivo físico en red local: http://TU_IP_LOCAL:5000
#    (Ejemplo: http://192.168.1.100:5000)
# 🌐 Para producción: https://tu-servidor.com
#
# 🔍 Para encontrar tu IP local:
#   Windows: ipconfig (busca "IPv4 Address" en tu adaptador Wi-Fi/Ethernet)
#   Mac/Linux: ifconfig o ip addr (busca "inet" en tu adaptador activo)
#
SERVER_URI=http://localhost:5000

# Firebase Configuration (opcional, si necesitas más variables)
# FIREBASE_API_KEY=tu-api-key-aqui
# FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
# FIREBASE_PROJECT_ID=tu-proyecto-id
# FIREBASE_DATABASE_URL=https://tu-proyecto.firebaseio.com

# Otras configuraciones
# API_TIMEOUT=10000
# DEBUG_MODE=true
